# Copy to .env and fill in. Never commit .env.
# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe to embed in a browser app.
# Dashboard → Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=

# Upstash Redis REST API — read-only credentials from the Upstash Console.
# These are OPTIONAL: if absent, the app falls back directly to Supabase PostgREST.
# Dashboard → Redis → REST API → Endpoint (REST URL)
VITE_UPSTASH_REDIS_REST_URL=

# Dashboard → Redis → REST API → Read Only Token
VITE_UPSTASH_REDIS_REST_READONLY_TOKEN=
