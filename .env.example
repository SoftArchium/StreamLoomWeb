# Copy to .env and fill in. Never commit .env.

# Upstash Redis REST API - the browser ONLY data source (ADR-0015).
# Supabase is never called from the client, so no Supabase keys belong here.
# These are required: without them the app has no catalogue to read.
# Dashboard -> Redis -> REST API -> Endpoint (REST URL)
VITE_UPSTASH_REDIS_REST_URL=

# Dashboard -> Redis -> REST API -> Read Only Token
VITE_UPSTASH_REDIS_REST_READONLY_TOKEN=

# Optional: TV guide programme-title translation (Guide page "English" toggle).
# Endpoint must be LibreTranslate-compatible (POST { q, source, target, format }).
# Leave blank to fall back to the public MyMemory API, which is rate limited.
VITE_TRANSLATE_URL=
# Only needed if the endpoint requires an API key.
VITE_TRANSLATE_API_KEY=
